{
	"name": "hxwl-dashboard",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "lefthook install",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:snapshot": "vitest run --config vitest.snapshot.config.ts",
		"build": "vite build",
		"dev": "vite",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"fetch:data": "node --env-file-if-exists=.env --import tsx scripts/fetch-data.ts",
		"fetch:public": "node --import tsx scripts/fetch-data.ts --raiderio-only",
		"preview": "vite preview --host 127.0.0.1",
		"fetch:refresh": "node --import tsx scripts/refresh-data.ts"
	},
	"dependencies": {
		"@picocss/pico": "^2.0.6",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.1.0",
		"@types/node": "22",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"happy-dom": "^15.11.7",
		"lefthook": "^1.10.0",
		"p-limit": "^6.2.0",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"vite": "^6.0.3",
		"vitest": "^2.1.8"
	},
	"packageManager": "pnpm@9.15.0",
	"engines": {
		"node": ">=22"
	}
}
